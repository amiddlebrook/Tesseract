{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "tesseract-grid-os",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
